<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>فروشگاه عیاشی | کیف، کفش و چمدان</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Tahoma, Arial, sans-serif;
      background: #f5f5f5;
      color: #222;
    }

    header {
      background: #111;
      color: white;
      text-align: center;
      padding: 25px 15px;
    }

    header h1 {
      margin: 0 0 10px;
      font-size: 30px;
    }

    header p {
      margin: 0;
      font-size: 16px;
    }

    .container {
      width: 95%;
      max-width: 1200px;
      margin: 25px auto;
    }

    .category {
      margin-bottom: 35px;
    }

    .category h2 {
      background: #222;
      color: white;
      padding: 12px 15px;
      border-radius: 10px;
      font-size: 21px;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 15px;
    }

    .product {
      background: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.12);
      text-align: center;
      padding-bottom: 12px;
    }

    .product img {
      width: 100%;
      height: 190px;
      object-fit: cover;
      display: block;
    }

    .product h3 {
      margin: 10px 5px 5px;
      font-size: 16px;
    }

    .product p {
      margin: 0;
      color: #777;
      font-size: 14px;
    }

    footer {
      background: #111;
      color: white;
      text-align: center;
      padding: 25px 10px;
      margin-top: 40px;
    }
  </style>
</head>

<body>

<header>
  <h1>فروشگاه عیاشی</h1>
  <p>عرضه انواع کیف، کفش، ساک و چمدان</p>
</header>

<div class="container">

  <section class="category">
    <h2>ساک ورزشی</h2>
    <div class="products">
      <div class="product"><img src="1.jpg"><h3>ساک ورزشی</h3><p>مدل ۱</p></div>
      <div class="product"><img src="2.jpg"><h3>ساک ورزشی</h3><p>مدل ۲</p></div>
      <div class="product"><img src="3.jpg"><h3>ساک ورزشی</h3><p>مدل ۳</p></div>
      <div class="product"><img src="4.jpg"><h3>ساک ورزشی</h3><p>مدل ۴</p></div>
      <div class="product"><img src="5.jpg"><h3>ساک ورزشی</h3><p>مدل ۵</p></div>
      <div class="product"><img src="6.jpg"><h3>ساک ورزشی</h3><p>مدل ۶</p></div>
    </div>
  </section>

  <section class="category">
    <h2>ساک مسافرتی</h2>
    <div class="products">
      <div class="product"><img src="7.jpg"><h3>ساک مسافرتی</h3><p>مدل ۷</p></div>
      <div class="product"><img src="8.jpg"><h3>ساک مسافرتی</h3><p>مدل ۸</p></div>
      <div class="product"><img src="9.jpg"><h3>ساک مسافرتی</h3><p>مدل ۹</p></div>
